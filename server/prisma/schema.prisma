generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  generatedFileExtension = "js"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id        String   @id @default(uuid(7))
  name      String
  username  String
  email     String   @unique
  password  String
  role      String
  createdAt DateTime @default(now())
  leads     Lead[]
  tasks     Task[]

  @@map("admin_users")
}

model Task {
  id           String    @id @default(uuid(7))
  title        String
  description  String
  clientId     String
  category     String
  priority     String
  status       String
  dueDate      DateTime
  dueDateLabel String    @default("Upcoming")
  createdAt    DateTime  @default(now())
  userId       String
  user         AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model Lead {
  id              String    @id @default(uuid(7))
  name            String
  email           String    @unique
  mobile          String    @unique
  interested      String
  lead_value      String
  pan             String    @unique
  status          String
  source          String
  nature          String
  follow_up_date  DateTime
  follow_up_label String    @default("Upcoming")
  reminder        Boolean
  description     String
  documents       String[]
  clientId        String?
  userId          String
  user            AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model CamsReport {
  id                    String            @id @default(uuid(7))
  messageId             String?           @unique
  identifierFingerprint String            @unique
  reportRequestNumber   String?
  reportNumber          String?
  dispatchDateTime      DateTime?
  toEmail               String?
  status                CamsReportStatus
  error                 String?
  transactionCount      Int               @default(0)
  processingAttempts    Int               @default(1)
  parsedAt              DateTime?
  storedAt              DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  transactions          CamsTransaction[]

  @@index([reportRequestNumber])
  @@index([dispatchDateTime])
  @@map("cams_reports")
}

model CamsTransaction {
  id                String     @id @default(uuid(7))
  reportId          String
  fingerprint       String
  createdAt         DateTime   @default(now())
  amcCode           String?
  folioNo           String?
  prodcode          String?
  scheme            String?
  invName           String?
  trxntype          String?
  trxnno            String?
  trxnmode          String?
  trxnstat          String?
  usercode          String?
  usrtrxno          String?
  traddate          String?
  postdate          String?
  purprice          String?
  units             String?
  amount            String?
  brokcode          String?
  subbrok           String?
  brokperc          String?
  brokcomm          String?
  altfolio          String?
  repDate           String?
  time1             String?
  trxnsubtyp        String?
  applicationNo     String?
  trxnNature        String?
  tax               String?
  totalTax          String?
  te15h             String?
  micrNo            String?
  remarks           String?
  swflag            String?
  oldFolio          String?
  seqNo             String?
  reinvestFlag      String?
  multBrok          String?
  stt               String?
  location          String?
  schemeType        String?
  taxStatus         String?
  load              String?
  scanrefno         String?
  pan               String?
  invIin            String?
  targSrcScheme     String?
  trxnTypeFlag      String?
  ticobTrtype       String?
  ticobTrno         String?
  ticobPostedDate   String?
  dpId              String?
  trxnCharges       String?
  eligibAmt         String?
  srcOfTxn          String?
  trxnSuffix        String?
  siptrxnno         String?
  terLocation       String?
  euin              String?
  euinValid         String?
  euinOpted         String?
  subBrkArn         String?
  exchDcFlag        String?
  srcBrkCode        String?
  sysRegnDate       String?
  acNo              String?
  bankName          String?
  reversalCode      String?
  exchangeFlag      String?
  caInitiatedDate   String?
  gstStateCode      String?
  igstAmount        String?
  cgstAmount        String?
  sgstAmount        String?
  revRemark         String?
  originalTrxnno    String?
  stampDuty         String?
  folioOld          String?
  schemeFolioNumber String?
  amcRefNo          String?
  requestRefNo      String?
  transmissionFlag  String?
  report            CamsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, fingerprint])
  @@index([folioNo])
  @@index([pan])
  @@index([trxnno])
  @@map("cams_transactions")
}

model AumPeriod {
  id                    String                 @id @default(uuid(7))
  financialYear         String                 @map("financial_year")
  quarter               Int
  periodStart           DateTime               @map("period_start") @db.Date
  periodEnd             DateTime               @map("period_end") @db.Date
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  imports               AumImport[]
  companyAums           CompanyAum[]
  companyAumFileImports CompanyAumFileImport[]
  industryAums          IndustryAum[]

  @@unique([financialYear, quarter])
  @@index([periodEnd])
  @@map("aum_periods")
}

model AumCategory {
  id           String        @id @default(uuid(7))
  code         String        @unique
  name         String
  level        Int
  isLeaf       Boolean       @default(false) @map("is_leaf")
  parentId     String?       @map("parent_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  parent       AumCategory?  @relation("AumCategoryHierarchy", fields: [parentId], references: [id])
  children     AumCategory[] @relation("AumCategoryHierarchy")
  companyAums  CompanyAum[]
  industryAums IndustryAum[]

  @@index([parentId])
  @@index([level])
  @@map("aum_categories")
}

model IndustryAum {
  id         String      @id @default(uuid(7))
  periodId   String      @map("period_id")
  categoryId String      @map("category_id")
  aum        Decimal     @db.Decimal(20, 4)
  aaum       Decimal     @db.Decimal(20, 4)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  category   AumCategory @relation(fields: [categoryId], references: [id])
  period     AumPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, categoryId])
  @@index([categoryId])
  @@index([periodId])
  @@map("industry_aum")
}

model CompanyAum {
  id              String      @id @default(uuid(7))
  periodId        String      @map("period_id")
  categoryId      String      @map("category_id")
  schemeName      String      @map("scheme_name")
  amcCode         String?     @map("amc_code")
  aum             Decimal     @db.Decimal(20, 4)
  aaum            Decimal     @db.Decimal(20, 4)
  daysRecorded    Int         @default(0) @map("days_recorded")
  lastUpdatedDate DateTime    @map("last_updated_date") @db.Date
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  category        AumCategory @relation(fields: [categoryId], references: [id])
  period          AumPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, schemeName])
  @@index([categoryId])
  @@index([periodId])
  @@index([amcCode])
  @@map("company_aum")
}

model CompanyAumFileImport {
  id                   String          @id @default(uuid(7))
  periodId             String          @map("period_id")
  fileName             String?         @map("file_name")
  fileHash             String          @map("file_hash")
  arnNo                String?         @map("arn_no")
  reportFromDate       String?         @map("report_from_date")
  reportToDate         String?         @map("report_to_date")
  status               AumImportStatus @default(PENDING)
  matchedSchemeCount   Int             @default(0) @map("matched_scheme_count")
  unmatchedSchemeCount Int             @default(0) @map("unmatched_scheme_count")
  totalClosingAssets   Decimal?        @map("total_closing_assets") @db.Decimal(20, 4)
  errorMessage         String?         @map("error_message")
  createdAt            DateTime        @default(now()) @map("created_at")
  completedAt          DateTime?       @map("completed_at")
  period               AumPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, fileHash])
  @@index([periodId])
  @@index([arnNo])
  @@map("company_aum_file_imports")
}

model AumImport {
  id           String          @id @default(uuid(7))
  source       AumImportSource
  periodId     String          @map("period_id")
  fileUrl      String?         @map("file_url")
  fileName     String?         @map("file_name")
  status       AumImportStatus @default(PENDING)
  startedAt    DateTime?       @map("started_at")
  completedAt  DateTime?       @map("completed_at")
  errorMessage String?         @map("error_message")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  period       AumPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([source, periodId])
  @@index([periodId])
  @@index([source, status])
  @@map("aum_imports")
}

model KarvyTransactionReport {
  id                    String             @id @default(uuid(7))
  messageId             String?            @unique
  identifierFingerprint String             @unique
  reportRequestNumber   String?
  reportNumber          String?
  dispatchDateTime      DateTime?
  toEmail               String?
  status                KarvyReportStatus
  error                 String?
  transactionCount      Int                @default(0)
  processingAttempts    Int                @default(1)
  parsedAt              DateTime?
  storedAt              DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  transactions          KarvyTransaction[]

  @@index([reportRequestNumber])
  @@index([dispatchDateTime])
  @@map("karvy_transaction_reports")
}

