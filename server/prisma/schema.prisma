// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid(7))
  name      String
  username  String
  email     String   @unique
  password  String
  role      String
  createdAt DateTime @default(now())

  tasks Task[]
  leads Lead[]
}

model Task {
  id           String   @id @default(uuid(7))
  title        String
  description  String
  clientId     String
  category     String
  priority     String
  status       String
  dueDate      DateTime
  dueDateLabel String   @default("Upcoming")
  createdAt    DateTime @default(now())

  user User @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Lead {
  id              String   @id @default(uuid(7))
  name            String
  email           String   @unique
  mobile          String   @unique
  interested      String
  lead_value      String
  pan             String   @unique
  status          String
  source          String
  nature          String
  follow_up_date  DateTime
  follow_up_label String   @default("Upcoming")
  reminder        Boolean
  description     String
  documents       String[]
  primary_user    String

  user User @relation(fields: [primary_user], references: [email], onDelete: Cascade)
}
