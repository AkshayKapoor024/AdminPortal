  @@index([schemeCode])
  @@index([isin])
  @@index([schemeName])
  @@index([amcCode])
  @@map("bse_scheme_masters")
}

model BseOrders {
  id              Int       @id @default(autoincrement())
  transaction_no  String    @unique @db.VarChar(255)
  bse_order_id    String?   @db.VarChar(255)
  client_code     String    @db.VarChar(255)
  bse_scheme_code String    @db.VarChar(255)
  order_type      String    @db.VarChar(255)
  buy_sell        String    @db.VarChar(255)
  buy_sell_type   String    @default("FRESH") @db.VarChar(255)
  amount          Decimal?  @db.Decimal(15, 2)
  units           Decimal?  @db.Decimal(18, 4)
  folio_no        String?   @db.VarChar(255)
  status          String    @default("PENDING") @db.VarChar(255)
  payment_ref_id  String?   @db.VarChar(255)
  refund_type     String?   @db.VarChar(255)
  remarks         String?
  last_webhook_at DateTime? @db.Timestamptz(6)
  raw_request     String?
  raw_response    String?
  createdAt       DateTime  @db.Timestamptz(6)
  updatedAt       DateTime  @db.Timestamptz(6)

  @@index([bse_order_id], map: "bse_orders_bse_order_id")
  @@index([bse_scheme_code], map: "bse_orders_bse_scheme_code")
  @@index([client_code], map: "bse_orders_client_code")
  @@index([status], map: "bse_orders_status")
}

model BseSchemes {
  id                  Int      @id @default(autoincrement())
  bse_scheme_code     String?  @unique @db.VarChar(255)
  isin                String?  @db.VarChar(255)
  scheme_name         String?  @db.VarChar(255)
  amc_code            String?  @db.VarChar(255)
  min_sip_amount      Decimal? @db.Decimal(10, 2)
  min_purchase_amount Decimal? @db.Decimal(10, 2)
  sip_multiplier      Decimal? @db.Decimal(10, 2)
  createdAt           DateTime @db.Timestamptz(6)
  updatedAt           DateTime @db.Timestamptz(6)
}

model BseStatusHistories {
  id              Int       @id @default(autoincrement())
  entity_type     String    @db.VarChar(255)
  entity_id       String    @db.VarChar(255)
  from_status     String?   @db.VarChar(255)
  to_status       String    @db.VarChar(255)
  event_name      String?   @db.VarChar(255)
  msgcode         String?   @db.VarChar(255)
  request_id      String?   @db.VarChar(255)
  remarks         String?
  details         String?
  event_timestamp DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @db.Timestamptz(6)
  updatedAt       DateTime  @db.Timestamptz(6)

  @@index([entity_type, entity_id], map: "bse_status_histories_entity_type_entity_id")
  @@index([event_timestamp], map: "bse_status_histories_event_timestamp")
  @@index([request_id], map: "bse_status_histories_request_id")
}

model BseUccs {
  id              Int       @id @default(autoincrement())
  client_code     String    @unique @db.VarChar(255)
  pan             String    @db.VarChar(255)
  first_name      String?   @db.VarChar(255)
  middle_name     String?   @db.VarChar(255)
  last_name       String?   @db.VarChar(255)
  dob             String?   @db.VarChar(255)
  gender          String?   @db.VarChar(255)
  email           String?   @db.VarChar(255)
  mobile          String?   @db.VarChar(255)
  address1        String?   @db.VarChar(255)
  address2        String?   @db.VarChar(255)
  address3        String?   @db.VarChar(255)
  city            String?   @db.VarChar(255)
  state           String?   @db.VarChar(255)
  pincode         String?   @db.VarChar(255)
  ifsc            String?   @db.VarChar(255)
  account_number  String?   @db.VarChar(255)
  account_type    String?   @db.VarChar(255)
  bse_status      Int?
  raw_response    String?
  last_webhook_at DateTime? @db.Timestamptz(6)
  two_fa_data     Json?     @db.Json
  createdAt       DateTime  @db.Timestamptz(6)
  updatedAt       DateTime  @db.Timestamptz(6)
}

model Clients {
  id           Int            @id @default(autoincrement())
  pan          String?        @unique @db.VarChar(255)
  inv_name     String         @db.VarChar(255)
  createdAt    DateTime       @db.Timestamptz(6)
  updatedAt    DateTime       @db.Timestamptz(6)
  Transactions Transactions[]
}

model NavHistories {
  id        Int       @id @default(autoincrement())
  date      DateTime? @db.Timestamptz(6)
  nav       Float?
  createdAt DateTime  @db.Timestamptz(6)
  updatedAt DateTime  @db.Timestamptz(6)
  schemeId  Int?
  Schemes   Schemes?  @relation(fields: [schemeId], references: [id])

  @@unique([schemeId, date], map: "nav_histories_scheme_id_date")
}

model RefreshTokens {
  id              Int       @id @default(autoincrement())
  token           String    @unique @db.VarChar(255)
  userId          Int
  expiresAt       DateTime  @db.Timestamptz(6)
  revokedAt       DateTime? @db.Timestamptz(6)
  replacedByToken String?   @db.VarChar(255)
  createdAt       DateTime  @db.Timestamptz(6)
  updatedAt       DateTime  @db.Timestamptz(6)
  Users           Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_id")
}

model Schemes {
  id                  Int            @id @default(autoincrement())
  amc_code            String?        @db.VarChar(255)
  prodcode            String?        @db.VarChar(255)
  scheme_name         String?        @db.VarChar(255)
  isin                String?        @db.VarChar(255)
  amfi_code           String?        @db.VarChar(255)
  min_sip_amount      Decimal?       @default(500) @db.Decimal(10, 2)
  min_purchase_amount Decimal?       @default(500) @db.Decimal(10, 2)
  return_3y           String?        @db.VarChar(255)
  createdAt           DateTime       @db.Timestamptz(6)
  updatedAt           DateTime       @db.Timestamptz(6)
  NavHistories        NavHistories[]
  Transactions        Transactions[]

  @@unique([amc_code, prodcode], map: "schemes_amc_code_prodcode")
}

model Transactions {
  id          Int       @id @default(autoincrement())
  folio_no    String?   @db.VarChar(255)
  trxntype    String?   @db.VarChar(255)
  txn_type    String?   @db.VarChar(255)
  trxn_nature String?   @db.VarChar(255)
  trxnno      String?   @db.VarChar(255)
  traddate    DateTime? @db.Timestamptz(6)
  postdate    DateTime? @db.Timestamptz(6)
  purprice    Float?
  units       Float?
  amount      Float?
  createdAt   DateTime  @db.Timestamptz(6)
  updatedAt   DateTime  @db.Timestamptz(6)
  clientId    Int?
  schemeId    Int?
  Clients     Clients?  @relation(fields: [clientId], references: [id])
  Schemes     Schemes?  @relation(fields: [schemeId], references: [id])
}

model Users {
  id                 Int             @id @default(autoincrement())
  phone              String          @db.VarChar(255)
  mpin               String?         @db.VarChar(255)
  panNumber          String          @unique @db.VarChar(255)
  failedMpinAttempts Int             @default(0)
  lockoutUntil       DateTime?       @db.Timestamptz(6)
  email              String?         @db.VarChar(255)
  onboarding_status  String?         @default("NOT_STARTED") @db.VarChar(255)
  createdAt          DateTime        @db.Timestamptz(6)
  updatedAt          DateTime        @db.Timestamptz(6)
  RefreshTokens      RefreshTokens[]
}

model bse_webhook_events {
  id            Int       @id @default(autoincrement())
  request_id    String    @unique(map: "bse_webhook_events_request_id") @db.VarChar(255)
  event_type    String?   @db.VarChar(255)
  event_name    String?   @db.VarChar(255)
  msgcode       String?   @db.VarChar(255)
  client_code   String?   @db.VarChar(255)
  status        String    @default("RECEIVED") @db.VarChar(255)
  error_message String?
  retry_count   Int?      @default(0)
  payload       String?
  received_at   DateTime? @db.Timestamptz(6)
  processed_at  DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @db.Timestamptz(6)
  updatedAt     DateTime  @db.Timestamptz(6)

  @@index([client_code], map: "bse_webhook_events_client_code")
  @@index([event_type], map: "bse_webhook_events_event_type")
  @@index([status], map: "bse_webhook_events_status")
}

enum CamsReportStatus {
  RECEIVED
  PARSED
  STORED
  SKIPPED
  FAILED
}

enum AumImportSource {
  AMFI
