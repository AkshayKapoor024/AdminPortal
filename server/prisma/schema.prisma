}

// ============================================================================
// AUM PERIOD
// Represents a financial reporting period/quarter.
// Example: FY 2025-26, Q4 = Jan-Mar 2026
// ============================================================================

model AumPeriod {
  id              String   @id @default(uuid(7))

  financialYear   String   @map("financial_year") // "2025-26"
  quarter         Int                              // 1, 2, 3, 4

  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  industryAums    IndustryAum[]
  companyAums     CompanyAum[]
  imports         AumImport[]

  @@unique([financialYear, quarter])
  @@index([periodEnd])
  @@map("aum_periods")
}


// ============================================================================
// AUM CATEGORY
// Stores the complete hierarchical AMFI category structure.
//
// Example:
//
// Open Ended Schemes
//   └── Income/Debt Oriented Schemes
//       └── Liquid/Cash Oriented Schemes
//           └── Overnight Fund
//
// parentId creates the hierarchy.
// ============================================================================

model AumCategory {
  id              String   @id @default(uuid(7))

  code            String   @unique
  name            String

  level           Int
  isLeaf          Boolean  @default(false) @map("is_leaf")

  parentId        String?  @map("parent_id")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Self-referencing hierarchy
  parent          AumCategory?  @relation("AumCategoryHierarchy", fields: [parentId], references: [id])
  children        AumCategory[] @relation("AumCategoryHierarchy")

  // Data
  industryAums    IndustryAum[]
  companyAums     CompanyAum[]

  @@index([parentId])
  @@index([level])
  @@map("aum_categories")
}


// ============================================================================
// INDUSTRY AUM
// Stores AMFI industry-level AUM / AAUM observations.
//
// One row = one category for one reporting period.
//
// Example:
// 2025-26 Q4 + Large Cap Fund
// AUM  = 366045.486
// AAUM = 405314.494
// ============================================================================

model IndustryAum {
  id              String   @id @default(uuid(7))

  periodId        String   @map("period_id")
  categoryId      String   @map("category_id")

  aum             Decimal  @db.Decimal(20, 4)
  aaum            Decimal  @db.Decimal(20, 4)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  period          AumPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  category        AumCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([periodId, categoryId])
  @@index([categoryId])
  @@index([periodId])
  @@map("industry_aum")
}


// ============================================================================
// COMPANY AUM
// Stores organization-specific AUM / AAUM observations.
//
// Uses the SAME AumCategory and AumPeriod tables as IndustryAum.
//
// This is critical because it allows direct industry-vs-company comparison.
// ============================================================================

model CompanyAum {
  id              String   @id @default(uuid(7))

  periodId        String   @map("period_id")
  categoryId      String   @map("category_id")

  aum             Decimal  @db.Decimal(20, 4)
  aaum            Decimal  @db.Decimal(20, 4)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  period          AumPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  category        AumCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([periodId, categoryId])
  @@index([categoryId])
  @@index([periodId])
  @@map("company_aum")
}


// ============================================================================
// AUM IMPORT
// Tracks ingestion of AMFI/company files.
//
// This table is NOT the financial data itself.
// It tells us whether a particular source file/period was discovered,
// downloaded and successfully processed.
// ============================================================================

model AumImport {
  id              String   @id @default(uuid(7))

  source          AumImportSource
  periodId        String   @map("period_id")

  fileUrl         String?  @map("file_url")
  fileName        String?  @map("file_name")

  status          AumImportStatus @default(PENDING)

  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")

  errorMessage    String?  @map("error_message")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relation
  period          AumPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([source, periodId])
  @@index([periodId])
  @@index([source, status])
  @@map("aum_imports")
}


// ============================================================================
// IMPORT SOURCE
// ============================================================================

enum AumImportSource {
  AMFI
  COMPANY
}


// ============================================================================
// IMPORT STATUS
// ============================================================================

enum AumImportStatus {
  PENDING
  DOWNLOADING
  PROCESSING
  COMPLETED
  FAILED
}
