// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid(7))
  name      String
  username  String
  email     String   @unique
  password  String
  role      String
  createdAt DateTime @default(now())

  tasks Task[]
  leads Lead[]

  @@map("users")
}

model Task {
  id           String   @id @default(uuid(7))
  title        String
  description  String
  clientId     String   // 👈 future FK to Client.id — plain string for now
  category     String
  priority     String
  status       String
  dueDate      DateTime
  dueDateLabel String   @default("Upcoming")
  createdAt    DateTime @default(now())

  // 👇 owner — the logged-in admin user
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model Lead {
  id              String   @id @default(uuid(7))
  name            String
  email           String   @unique
  mobile          String   @unique
  interested      String
  lead_value      String
  pan             String   @unique
  status          String
  source          String
  nature          String
  follow_up_date  DateTime
  follow_up_label String   @default("Upcoming")
  reminder        Boolean
  description     String
  documents       String[]
  clientId        String?  // 👈 optional, same future-proofing as Task

  // 👇 owner — the logged-in admin user (renamed from primary_user)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leads")
}

enum CamsReportStatus {
  RECEIVED
  PARSED
  STORED
  SKIPPED
  FAILED
}

model CamsReport {
  id                    String           @id @default(uuid(7))
  messageId             String?          @unique
  identifierFingerprint String           @unique
  reportRequestNumber   String?
  reportNumber          String?
  dispatchDateTime      DateTime?
  toEmail               String?
  status                CamsReportStatus
  error                 String?
  transactionCount      Int              @default(0)
  processingAttempts    Int              @default(1)
  parsedAt              DateTime?
  storedAt              DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  transactions CamsTransaction[]

  @@index([reportRequestNumber])
  @@index([dispatchDateTime])
  @@map("cams_reports")
}

