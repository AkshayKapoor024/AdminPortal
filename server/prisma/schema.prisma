// ============================================================================
// AUM PERIOD
// Represents a financial reporting period/quarter.
// Example: FY 2025-26, Q4 = Jan-Mar 2026
// ============================================================================

model AumPeriod {
  id              String   @id @default(uuid(7))

  financialYear   String   @map("financial_year") // "2025-26"
  quarter         Int                              // 1, 2, 3, 4

  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  industryAums    IndustryAum[]
  companyAums     CompanyAum[]
  imports         AumImport[]
  companyAumFileImports CompanyAumFileImport[]

  @@unique([financialYear, quarter])
  @@index([periodEnd])
  @@map("aum_periods")
}


// ============================================================================
// AUM CATEGORY
// Stores the complete hierarchical AMFI category structure.
//
// Example:
//
// Open Ended Schemes
//   └── Income/Debt Oriented Schemes
//       └── Liquid/Cash Oriented Schemes
//           └── Overnight Fund
//
// parentId creates the hierarchy.
// ============================================================================

model AumCategory {
  id              String   @id @default(uuid(7))

  code            String   @unique
  name            String

  level           Int
  isLeaf          Boolean  @default(false) @map("is_leaf")

  parentId        String?  @map("parent_id")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Self-referencing hierarchy
  parent          AumCategory?  @relation("AumCategoryHierarchy", fields: [parentId], references: [id])
  children        AumCategory[] @relation("AumCategoryHierarchy")

  // Data
  industryAums    IndustryAum[]
  companyAums     CompanyAum[]

  @@index([parentId])
  @@index([level])
  @@map("aum_categories")
}


// ============================================================================
// INDUSTRY AUM
// Stores AMFI industry-level AUM / AAUM observations.
//
// One row = one category for one reporting period.
//
// Example:
// 2025-26 Q4 + Large Cap Fund
// AUM  = 366045.486
// AAUM = 405314.494
// ============================================================================

model IndustryAum {
  id              String   @id @default(uuid(7))

  periodId        String   @map("period_id")
  categoryId      String   @map("category_id")

  aum             Decimal  @db.Decimal(20, 4)
  aaum            Decimal  @db.Decimal(20, 4)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  period          AumPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  category        AumCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([periodId, categoryId])
  @@index([categoryId])
  @@index([periodId])
  @@map("industry_aum")
}


// ============================================================================
// COMPANY AUM
// Stores organization-specific AUM / AAUM observations, one row per
// (fund, quarter).
//
// Uses the SAME AumCategory and AumPeriod tables as IndustryAum, which
// is what makes direct industry-vs-company comparison possible.
//
// UPDATED STORAGE MODEL (daily real-time data, not quarterly batches):
// CAMS and Karvy now both send WBR22-equivalent files DAILY, so this
// table is a per-fund, per-quarter row that's kept continuously current
// via three update cases (see `services/cams_wbr22/companyAumIngestionService.js`
// and `services/karvy_wbr22_automation/karvyCompanyAumIngestionService.js`
// for the exact logic both pipelines share):
//   1. Another file arrives for a fund already updated TODAY (same
//      calendar day) -> ADD to today's running total (different files
//      on the same day represent different, non-overlapping clients).
//   2. A file arrives for a fund whose last update was an EARLIER day
//      in the SAME quarter -> OVERWRITE with today's fresh total.
//   3. A file arrives for a NEW quarter -> CREATE a new row; the
//      previous quarter's row is never touched again, frozen as
//      permanent history.
// `categoryId` and `amcCode` are static attributes of each fund, not
// separate keys — grouping by either at query time gives the
// category-wise or AMC-wise rollup, so only one table is needed.
// ============================================================================

model CompanyAum {
  id              String   @id @default(uuid(7))

  periodId        String   @map("period_id")
  categoryId      String   @map("category_id")

  // The fund's own identity — the matched, canonical master-scheme-list
  // name. This is now the row's real identity (one row per fund per
  // quarter); `categoryId` and `amcCode` are descriptive attributes of
  // that fund, not separate keys, so a plain GROUP BY on either gives
  // the category-wise or AMC-wise rollup without needing separate
  // tables. Storing the name itself is a deliberate, confirmed change
  // from this table's original "never store fund names" design.
  schemeName      String   @map("scheme_name")

  // From the master scheme list's "AMC Code" (e.g. "HDFCMutualFund_MF").
  // Nullable because older/unmatched rows may not have resolved one.
  amcCode         String?  @map("amc_code")

  aum             Decimal  @db.Decimal(20, 4)
  aaum            Decimal  @db.Decimal(20, 4)

  // How many distinct calendar days' figures have been folded into
  // `aaum` so far this quarter. Used to compute `aaum` as a running
  // average across days (not across funds, as the old category-level
  // table did) — incremented only when a NEW day's figures arrive
  // (never on a same-day same-quarter top-up).
  daysRecorded    Int      @default(0) @map("days_recorded")

  // The calendar day (no time component) this row was last updated on.
  // This is what distinguishes "another file arrived today — add to
  // today's total" from "a new day has started — overwrite with
  // today's fresh total" from "a new quarter has started — this
  // becomes a new row entirely, and the old quarter's row is left
  // untouched as permanent history."
  lastUpdatedDate DateTime @db.Date @map("last_updated_date")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  period          AumPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  category        AumCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([periodId, schemeName])
  @@index([categoryId])
  @@index([periodId])
  @@index([amcCode])
  @@map("company_aum")
}


// ============================================================================
// COMPANY AUM FILE IMPORT
// Tracks ingestion of individual company WBR22 files.
//
// This is deliberately a SEPARATE table from AumImport: AumImport assumes
// exactly one file per (source, period) — true for AMFI's one-XLSX-per-
// quarter model, but not true here, since the company's data for one
// quarter legitimately arrives as several separate WBR22 files (one per
// broker/dealer batch/email). So this table allows many rows per period,
// one per uploaded file, keyed by that file's content hash — which also
// gives us duplicate-file protection: if the exact same file is
// accidentally uploaded twice, its hash is recognised and it is skipped
// instead of double-adding its figures into CompanyAum.
// ============================================================================

model CompanyAumFileImport {
  id                   String          @id @default(uuid(7))

  periodId             String          @map("period_id")

  fileName             String?         @map("file_name")
  fileHash             String          @map("file_hash")

  status               AumImportStatus @default(PENDING)

  matchedSchemeCount   Int             @default(0) @map("matched_scheme_count")
  unmatchedSchemeCount Int             @default(0) @map("unmatched_scheme_count")
  totalClosingAssets   Decimal?        @db.Decimal(20, 4) @map("total_closing_assets")

  errorMessage         String?         @map("error_message")

  createdAt            DateTime        @default(now()) @map("created_at")
  completedAt          DateTime?       @map("completed_at")

  // Relation
  period               AumPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, fileHash])
  @@index([periodId])
  @@map("company_aum_file_imports")
}


// ============================================================================
// AUM IMPORT
// Tracks ingestion of AMFI/company files.
//
// This table is NOT the financial data itself.
// It tells us whether a particular source file/period was discovered,
// downloaded and successfully processed.
// ============================================================================

model AumImport {
  id              String   @id @default(uuid(7))

  source          AumImportSource
  periodId        String   @map("period_id")

  fileUrl         String?  @map("file_url")
  fileName        String?  @map("file_name")

  status          AumImportStatus @default(PENDING)

  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")

  errorMessage    String?  @map("error_message")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relation
  period          AumPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([source, periodId])
  @@index([periodId])
  @@index([source, status])
  @@map("aum_imports")
}


// ============================================================================
// IMPORT SOURCE
// ============================================================================

enum AumImportSource {
  AMFI
  COMPANY
}


// ============================================================================
// IMPORT STATUS
// ============================================================================

enum AumImportStatus {
  PENDING
  DOWNLOADING
  PROCESSING
  COMPLETED
  FAILED
}


// ============================================================================
// KARVY (KFINTECH) TRANSACTIONS
//
// Mirrors the CamsReport / CamsTransaction pattern exactly (same status
// lifecycle, same identifier-fingerprint idempotency strategy, same
// "every field stored as a string" convention), but as fully separate
// models — Karvy's "Transaction Feeds Report" CSV has 90 columns with
// entirely different names from CAMS's 80-column WBR2 format, so the
// two are not interchangeable and must not share a table.
// ============================================================================

enum KarvyReportStatus {
  RECEIVED
  PARSED
  STORED
  SKIPPED
  FAILED
}

model KarvyTransactionReport {
  id                    String            @id @default(uuid(7))
  messageId             String?           @unique
  identifierFingerprint String            @unique
  reportRequestNumber   String?
  reportNumber          String?
  dispatchDateTime      DateTime?
  toEmail               String?
  status                KarvyReportStatus
  error                 String?
  transactionCount      Int               @default(0)
  processingAttempts    Int               @default(1)
  parsedAt              DateTime?
  storedAt              DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  transactions KarvyTransaction[]

  @@index([reportRequestNumber])
  @@index([dispatchDateTime])
  @@map("karvy_transaction_reports")
}

model KarvyTransaction {
  id          String   @id @default(uuid(7))
  reportId    String
  fingerprint String
  createdAt   DateTime @default(now())

  report KarvyTransactionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

